#--------------------------Guardar registro-------------------------------
    def guardar_registro(self):
        try:
            nsesiones =int(self.entrysesiones.get())
        except ValueError:
            self.labelresultado.config(text="El número de sesiones debe ser un número entero")
            return 
        
        sesiones_validas = verificar_nsesiones(nsesiones) 
        identificacion = self.entryid.get()
        identificación_válida = verificar_identificación(identificacion)
        nombre = self.entrynombre.get()
        nombre_válido = verificar_nombre(nombre)
        genero = self.combogenero.get()
        género_válido =  verificar_genero(genero, generos)
        menu = self.combomenu.get()
        menu_verificado = verificar_menu(menu,menus)
        costo = menus[menu]
    

        if sesiones_validas and identificación_válida and nombre_válido and género_válido and menu_verificado:
            self.labelresultado.config(text="La información fue ingresada exitosamente")
            self.cliente = GestionClientes(nombre, identificacion, genero, menu, costo, nsesiones)
        else:
            self.labelresultado.config(text="Hay información inválida, por favor revise el formulario")    
            

#-----------------------------Funciones-----------------------------------------

#Función que muestra los costos
    def revelar_costo(self, event):
        self.entrymenu.config(state="normal")
        self.entrymenu.delete(0, tk.END)
        self.entrymenu.insert(0, f"Costo: {menus[self.combomenu.get()]}")
        self.entrymenu.config(state="disabled")


#--------------------Método Cálcular reporte------------------------------
    def abrir_reporte(self):
     if self.cliente is None:
        self.labelresultado.config(text= "Primero debes ingresar la información")
     else:
        self.ventana3 = tk.Toplevel()
        self.ventana3.config(bg="#FAF3E0")
        self.reportenombre = tk.Label(self.ventana3, text=f"{self.cliente.nombre}", bg="#FAF3E0", fg="#2B2118")
        self.reporteid = tk.Label(self.ventana3, text=f"{self.cliente.identificacion}", bg="#FAF3E0", fg="#2B2118")
        self.reportegénero = tk.Label(self.ventana3, text=f"{self.cliente.genero}", bg="#FAF3E0", fg="#2B2118")
        self.reportemenu = tk.Label(self.ventana3, text=f"{self.cliente.menu}", bg="#FAF3E0", fg="#2B2118")
        self.reportecosto = tk.Label(self.ventana3, text=f"{self.cliente.costo_sesion}", bg="#FAF3E0", fg="#2B2118")
        self.reportensesiones = tk.Label(self.ventana3, text=f"{self.cliente.nsesiones}", bg="#FAF3E0", fg="#2B2118")
        self.reportetotal = tk.Label(self.ventana3, text=f"{self.cliente.calculo_total(self.cliente.costo_sesion, self.cliente.nsesiones)}", bg="#FAF3E0", fg="#2B2118")


        self.reportenombre.pack(pady=2)
        self.reporteid.pack(pady=2)
        self.reportegénero.pack(pady=2)
        self.reportemenu.pack(pady=2)
        self.reportecosto.pack(pady=2)
        self.reportensesiones.pack(pady=2)
        self.reportetotal.pack(pady=2)


