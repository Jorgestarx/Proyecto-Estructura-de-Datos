
import tkinter as tk
from tkinter import ttk
import datetime

#verificaciones
from registro import verificar_identificación, verificar_nombre, verificar_genero, verificar_nsesiones, generos, menus, verificar_menu, GestionClientes



#---------------------------------------------funciones----------------------------------------------------------

#Función contraseña inicio
def verificar_contraseña():
    if entrycontraseña.get() == "1793":
        mensaje2.config(text="Contraseña correcta")
        VentanaRegistro()
        boton.config(state = "disabled")
    else:
        mensaje2.config(text="Contraseña incorrecta")





#Clase que abre nueva ventana desde el inicio de sesión
class VentanaRegistro():
    def __init__(self):
        self.ventana2 = tk.Toplevel()
        self.ventana2.geometry("700x700")
        self.ventana2.title("Registro")
        #widgets 
        self.etiqueta1 = tk.Label(self.ventana2, text = "Datos")
        #widgets identificación
        self.labelid=tk.Label(self.ventana2, text = "Identificación")
        self.labelid2 = tk.Label(self.ventana2, text ="")
        self.botonid = tk.Button(self.ventana2, text="verificar", command=self.verif_id)
        
        
        #entry identificación
        self.entryid = tk.Entry(self.ventana2)
        
        
        #Widgets nombre
        self.labelnombre = tk.Label(self.ventana2, text="Nombre completo")
        self.entrynombre = tk.Entry(self.ventana2)
        self.labelnombre2 = tk.Label(self.ventana2, text="")
        self.botonnombre = tk.Button(self.ventana2, text="Verificar", command= self.verif_nombre)

        #Widgets genero
        self.labelgenero = tk.Label(self.ventana2, text = "Genero")
        self.combogenero = ttk.Combobox(self.ventana2, values=generos, state = "readonly")
        self.labelgenero2 = tk.Label(self.ventana2, text ="")
        self.botongenero = tk.Button(self.ventana2, text="Verificar", command=self.verif_genero)


        #Widgets Menu
        self.labelmenu = tk.Label(self.ventana2, text="Menu")
        self.combomenu = ttk.Combobox(self.ventana2, values=list(menus.keys()), state="readonly")
        self.entrymenu = tk.Entry(self.ventana2, state="disabled")


        #Widgets número de sesiones
        self.labelsesiones = tk.Label(self.ventana2, text="Número de sesiones")
        self.entrysesiones = tk.Entry(self.ventana2)
        self.labelsesiones2 = tk.Label(self.ventana2, text="")
        self.botonsesiones = tk.Button(self.ventana2, text="Verificar", command= self.verif_sesiones)

        #Registro fecha
        registro = datetime.datetime.now()
        self.registro = registro.strftime("%d/%m/%Y  %H:%M")
        self.labelfecha = tk.Label(self.ventana2, text="Fecha de registro")
        self.labelfecha2 = tk.Label(self.ventana2, text= f"{self.registro}")
        


        #Resultado TODAS LAS FUNCIONES
        self.labelresultado = tk.Label(self.ventana2, text="")

        #Botón guardar
        self.botonguardar = tk.Button(self.ventana2, text="Guardar", command= self.guardar_registro)
        #---------------.packs-----------------------
        #id
        self.etiqueta1.pack(pady = 2)
        self.labelid.pack(pady = 2)
        self.entryid.pack(pady =3)
        self.labelid2.pack(pady=2)
        self.botonid.pack(pady=2)
        #nombre
        self.labelnombre.pack(pady=2)
        self.entrynombre.pack(pady=3)
        self.labelnombre2.pack(pady=3)
        self.botonnombre.pack(pady=2)
        #genero
        self.labelgenero.pack(pady=2)
        self.combogenero.pack(pady=3)
        self.labelgenero2.pack(pady=2)
        self.botongenero.pack(pady=2)

        #Menu
        self.labelmenu.pack(pady=2)
        self.combomenu.pack(pady=2)
        self.combomenu.bind("<<ComboboxSelected>>", self.revelar_costo)
        self.entrymenu.pack(pady=2)
   

        #Sesiones
        self.labelsesiones.pack(pady=2)
        self.entrysesiones.pack(pady=3)
        self.labelsesiones2.pack(pady=2)
        self.botonsesiones.pack(pady=2)

        #registro fecha
        self.labelfecha.pack(pady=2)
        self.labelfecha2.pack(pady = 2)

        #Resultado TODAS LAS FUNCIONES
        self.labelresultado.pack(pady=2)

        #Botón guardar 
        self.botonguardar.pack(pady=3)


#--------------------------Guardar registro-------------------------------
    def guardar_registro(self):
        try:
            nsesiones =int(self.entrysesiones.get())
        except ValueError:
            self.labelresultado.config(text="El número de sesiones debe ser un número entero")
            return 
        sesiones_validas = verificar_nsesiones(nsesiones) 
        identificación = self.entryid.get()
        identificación_válida = verificar_identificación(identificación)
        nombre = self.entrynombre.get()
        nombre_válido = verificar_nombre(nombre)
        género = self.combogenero.get()
        género_válido =  verificar_genero(género, generos)
        menu = self.combomenu.get()
        menu_verificado = verificar_menu(menu,menus)
        costo = menus[menu]

        if sesiones_validas and identificación_válida and nombre_válido and género_válido and menu_verificado:
            self.labelresultado.config(text="La información fue ingresada exitosamente")
            self.cliente = GestionClientes(nombre, identificación, género, menu, costo, nsesiones)
        else:
            self.labelresultado.config(text="Hay información inválida, por favor revise el formulario")    
            

#-----------------------------Funciones-----------------------------------------
#Función verificación entry identificación
    def verif_id(self):
        if verificar_identificación(self.entryid.get()):
            self.labelid2.config(text="Identificación válida")
            self.botonid.config(state="disabled")
        else:
            self.labelid2.config(text="Identificación inválida")

#Función verificación nombre
    def verif_nombre(self):
        if verificar_nombre(self.entrynombre.get()):
            self.labelnombre2.config(text="Nombre ingresado correctamente")
        else:
            self.labelnombre2.config(text="Nombre inválido, intente nuevamente")

#Función verificación género
    def verif_genero(self):
        if verificar_genero(self.combogenero.get(), generos):
            self.labelgenero2.config(text="Genero ingresado exitosamente")
        else:
            self.labelgenero2.config(text="Género ingresado es inválido")

#Función que muestra los costos
    def revelar_costo(self, event):
        self.entrymenu.config(state="normal")
        self.entrymenu.delete(0, tk.END)
        self.entrymenu.insert(0, f"Costo: {menus[self.combomenu.get()]}")
        self.entrymenu.config(state="disabled")


#Función número de sesiones
    def verif_sesiones(self):
      try: 
        nsesiones = int(self.entrysesiones.get())
        if verificar_nsesiones(nsesiones):
            self.labelsesiones2.config(text="Número de sesiones válido")
        else:
            self.labelsesiones2.config(text = "Número de sesiones inválido, debe ser mayor a cero")
      except ValueError:
        self.labelsesiones2.config(text="Número de sesiones inválido. Asegurese de que sea un número entero")

