
import tkinter as tk
from tkinter import ttk

#verificaciones
from registro import verificar_identificación



#---------------------------------------------funciones----------------------------------------------------------

#Función contraseña inicio
def verificar_contraseña():
    if entrycontraseña.get() == "1793":
        mensaje2.config(text="Contraseña correcta")
        VentanaRegistro()
        boton.config(state = "disabled")
    else:
        mensaje2.config(text="Contraseña incorrecta")





#Clase que abre nueva ventana desde el inicio de sesión
class VentanaRegistro():
    def __init__(self):
        self.ventana2 = tk.Toplevel()
        self.ventana2.geometry("600x600")
        self.ventana2.title("Registro")
        #widgets 
        self.etiqueta1 = tk.Label(self.ventana2, text = "Datos")
        #widgets identificación
        self.etiquetaid=tk.Label(self.ventana2, text = "Identificación")
        self.etiquetaid2 = tk.Label(self.ventana2, text ="")
        self.botonverif = tk.Button(self.ventana2, text="verificar", command=self.verif_boton_id)
        
        
        #entry identificación
        self.ingreso_id = tk.Entry(self.ventana2)
        
        
        
        self.etiqueta1.pack(pady = 2)
        self.etiquetaid.pack(pady = 2)
        self.ingreso_id.pack(pady =3)
        self.etiquetaid2.pack(pady=2)
        self.botonverif.pack(pady=2)
   
#Función verificación entry identificación
    def verif_boton_id(self):
        if verificar_identificación(self.ingreso_id.get()):
            self.etiquetaid2.config(text="Identificación válida")
            self.botonverif.config(state="disabled")
        else:
            self.etiquetaid2.config(text="Identificación inválida")

        
#---------------------------------Página principal--------------------------------
ventana = tk.Tk()

ventana.title("LA RAMBLA ROJA")

ventana.geometry("1300x700")

#---------------------------------------widgets ventana principal----------------

#Mensaje incial
mensaje1 = tk.Label(ventana, text = "Contraseña:", font = "Arial 9")

#mensaje contraseña incorrecta
mensaje2 = tk.Label(ventana, text ="")

#Autor
autor = tk.Label(ventana,text= "Jorge Andrés Gómez Betancur")


#Nombre negocio
namenegocio = tk.Label(ventana, text="LA RAMBLA ROJA", font="Helvetica 11")

#Entrada de contraseña
entrycontraseña = tk.Entry(ventana, show="*")


#Botón contraseña
boton = tk.Button(ventana, text = "Iniciar sesión", command = verificar_contraseña)

#comandos llamada widgets
namenegocio.pack(pady=4)
autor.pack(pady=4)
entrycontraseña.pack(pady=3)
mensaje1.pack(pady=3)
mensaje2.pack(pady=3)
boton.pack(pady=3)

#comando llamada ventana
ventana.mainloop()