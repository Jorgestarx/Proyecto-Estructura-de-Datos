
import tkinter as tk
from tkinter import ttk

#verificaciones
from registro import verificar_identificación, verificar_nombre



#---------------------------------------------funciones----------------------------------------------------------

#Función contraseña inicio
def verificar_contraseña():
    if entrycontraseña.get() == "1793":
        mensaje2.config(text="Contraseña correcta")
        VentanaRegistro()
        boton.config(state = "disabled")
    else:
        mensaje2.config(text="Contraseña incorrecta")





#Clase que abre nueva ventana desde el inicio de sesión
class VentanaRegistro():
    def __init__(self):
        self.ventana2 = tk.Toplevel()
        self.ventana2.geometry("600x600")
        self.ventana2.title("Registro")
        #widgets 
        self.etiqueta1 = tk.Label(self.ventana2, text = "Datos")
        #widgets identificación
        self.labelid=tk.Label(self.ventana2, text = "Identificación")
        self.labelid2 = tk.Label(self.ventana2, text ="")
        self.botonid = tk.Button(self.ventana2, text="verificar", command=self.verif_boton_id)
        
        
        #entry identificación
        self.entry_id = tk.Entry(self.ventana2)
        
        
        #Widgets nombre
        self.labelnombre = tk.Label(self.ventana2, text="Nombre completo")
        self.entry_nombre = tk.Entry(self.ventana2)
        self.labelnombre2 = tk.Label(self.ventana2, text="")
        self.botonnombre = tk.Button(self.ventana2, text="Verificar", command= self.verif_boton_nombre) #Boton verificación nombre FALTA AGREGAR COMANDO DE FUNCIÓN

        #.packs
        #id
        self.etiqueta1.pack(pady = 2)
        self.labelid.pack(pady = 2)
        self.entry_id.pack(pady =3)
        self.labelid2.pack(pady=2)
        self.botonid.pack(pady=2)
        #nombre
        self.labelnombre.pack(pady=2)
        self.entry_nombre.pack(pady=3)
        self.labelnombre2.pack(pady=3)
        self.botonnombre.pack(pady=2)
   
#Función verificación entry identificación
    def verif_boton_id(self):
        if verificar_identificación(self.entry_id.get()):
            self.labelid2.config(text="Identificación válida")
            self.botonid.config(state="disabled")
        else:
            self.labelid2.config(text="Identificación inválida")

#Función verificación nombre
    def verif_boton_nombre(self):
        if verificar_nombre(self.entry_nombre.get()):
            self.labelnombre2.config(text="Nombre ingresado correctamente")
        else:
            self.labelnombre2.config(text="Nombre inválido, intente nuevamente")

#---------------------------------Página principal--------------------------------
ventana = tk.Tk()

ventana.title("LA RAMBLA ROJA")

ventana.geometry("1300x700")

#---------------------------------------widgets ventana principal----------------

#Mensaje incial
mensaje1 = tk.Label(ventana, text = "Contraseña:", font = "Arial 9")

#mensaje contraseña incorrecta
mensaje2 = tk.Label(ventana, text ="")

#Autor
autor = tk.Label(ventana,text= "Jorge Andrés Gómez Betancur")


#Nombre negocio
namenegocio = tk.Label(ventana, text="LA RAMBLA ROJA", font="Helvetica 11")

#Entrada de contraseña
entrycontraseña = tk.Entry(ventana, show="*")


#Botón contraseña
boton = tk.Button(ventana, text = "Iniciar sesión", command = verificar_contraseña)

#comandos llamada widgets
namenegocio.pack(pady=4)
autor.pack(pady=4)
entrycontraseña.pack(pady=3)
mensaje1.pack(pady=3)
mensaje2.pack(pady=3)
boton.pack(pady=3)

#comando llamada ventana
ventana.mainloop()